---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Toc from "@/components/Toc.astro";
import { getPosts, formatDate, href, readingMinutes, SITE, CATEGORY_LABEL, categoryHref } from "@/lib";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const minutes = readingMinutes(post.body);
const url = new URL(href(`${post.id}/`), Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { "@type": "Organization", name: d.author },
  articleSection: d.category,
  timeRequired: `PT${minutes}M`,
  image: new URL(href(`og/${post.id}.png`), Astro.site).toString(),
  mainEntityOfPage: url,
  publisher: { "@type": "Organization", name: "Personal Jarvis", url: SITE.main },
};
---

<Base
  title={d.title}
  description={d.description}
  image={href(`og/${post.id}.png`)}
  article={{ published: d.pubDate, modified: d.updatedDate, section: d.category }}
  jsonLd={jsonLd}
>
  <main class="wrap article">
    <header class="col">
      <div class="kicker small">
        <a href={categoryHref(d.category)}>{CATEGORY_LABEL[d.category]}</a>
        <span class="num">{formatDate(d.pubDate)}</span>
      </div>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline small">
        <span>By {d.author}</span>
        <span>{minutes} min read</span>
        {d.version && <span>Written against Jarvis {d.version}</span>}
      </div>
    </header>
    <div class="article-body">
      <Toc headings={headings} />
      <article class="prose">
        <Content />
      </article>
    </div>
  </main>
</Base>

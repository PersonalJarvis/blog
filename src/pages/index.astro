---
import Base from "@/layouts/Base.astro";
import { getPosts, formatDate, href, readingMinutes, SITE } from "@/lib";

const posts = await getPosts();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: SITE.title,
  url: new URL(href(), Astro.site).toString(),
  description: SITE.tagline,
  publisher: { "@type": "Organization", name: "Personal Jarvis", url: SITE.main },
};
---

<Base title={SITE.title} description={SITE.tagline} jsonLd={jsonLd}>
  <main class="wrap">
    <section class="masthead">
      <h1>Notes from building Personal Jarvis</h1>
      <p>What we ship, what we measure while shipping it, and how to get more out of an AI assistant that runs on your own machine.</p>
    </section>
    <ol class="entries">
      {
        posts.map((p) => (
          <li class="entry">
            <a href={href(`${p.id}/`)}>
              <div class="meta small">
                <div class="num">{formatDate(p.data.pubDate)}</div>
                <div>{readingMinutes(p.body)} min read</div>
              </div>
              <div>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</Base>

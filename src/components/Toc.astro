---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// Section headings only: h2 for the sections, h3 nested under them.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 2 && (
    <nav class="toc small" aria-label="On this page">
      <details class="toc-box" open>
        <summary class="toc-title">On this page</summary>
        <ol>
          {items.map((h) => (
            <li class={`toc-d${h.depth}`}>
              <a href={`#${h.slug}`} data-toc={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  // Marks the section the reader is in. The current section is the last
  // heading that has scrolled past a line in the upper quarter of the window.
  //
  // Near the end of the page that line slides down to the bottom edge. The
  // last sections are often too short for their headings to ever reach the
  // upper quarter: the page runs out of scroll first, and the mark stayed on
  // an earlier section with the reader at the very bottom. Over the last
  // screen of scroll the line moves from the upper quarter to the bottom, so
  // each remaining heading still gets its turn and the last one is marked at
  // the end.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a[data-toc]")];
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  // The sidebar is always open; the narrow-screen box starts closed.
  const box = document.querySelector<HTMLDetailsElement>(".toc-box");
  const wide = window.matchMedia("(min-width: 74rem)");
  const syncOpen = () => {
    if (box) box.open = wide.matches;
  };
  syncOpen();
  wide.addEventListener("change", syncOpen);

  let current: HTMLAnchorElement | undefined;
  let queued = false;
  const update = () => {
    queued = false;
    const view = window.innerHeight;
    const left = document.documentElement.scrollHeight - (window.scrollY + view);
    const nearEnd = Math.min(1, Math.max(0, 1 - left / view));
    const line = view * (0.25 + 0.75 * nearEnd);
    let active: HTMLElement | undefined;
    for (const el of targets) {
      if (el.getBoundingClientRect().top <= line) active = el;
      else break;
    }
    const link = active ? links.find((a) => a.dataset.toc === active.id) : undefined;
    if (link === current) return;
    current?.removeAttribute("aria-current");
    link?.setAttribute("aria-current", "location");
    current = link;
  };
  const queue = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  if (targets.length) {
    window.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", queue, { passive: true });
    update();
  }
</script>

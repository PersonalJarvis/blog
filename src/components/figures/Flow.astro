---
/**
 * A left-to-right pipeline of steps with arrows; stacks vertically on phones.
 * Mark one step `hero` to paint it gold (the step the post is about), and use
 * `fan` to show a step that runs N copies in parallel.
 */
interface Step {
  title: string;
  note?: string;
  tag?: string;
  hero?: boolean;
  fan?: number;
}
interface Props {
  steps: Step[];
  loopLabel?: string;
}
const { steps, loopLabel } = Astro.props;
---

<div class="flow">
  {
    steps.map((s, i) => (
      <>
        <div class:list={["step", { hero: s.hero }]}>
          {s.tag && <span class="tag mono">{s.tag}</span>}
          <strong>{s.title}</strong>
          {s.note && <span class="note">{s.note}</span>}
          {s.fan && (
            <span class="fan" aria-hidden="true">
              {Array.from({ length: s.fan }).map(() => (
                <i />
              ))}
            </span>
          )}
        </div>
        {i < steps.length - 1 && (
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 12">
              <path d="M0 6h20M15 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </span>
        )}
      </>
    ))
  }
</div>
{loopLabel && <div class="loop mono">↺ {loopLabel}</div>}

<style>
  .flow {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }
  .step {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 14px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--canvas);
  }
  .step strong {
    color: var(--ink);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .note {
    color: var(--ink-3);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .tag {
    color: var(--ink-4);
    font-size: 0.625rem;
  }
  .hero {
    border-color: var(--gold);
    background: var(--gold-wash);
  }
  .hero .tag {
    color: var(--gold);
  }
  .fan {
    display: flex;
    gap: 4px;
    margin-top: auto;
    padding-top: 6px;
  }
  .fan i {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    background: var(--gold);
    opacity: 0.85;
  }
  .arrow {
    flex: none;
    align-self: center;
    width: 22px;
    color: var(--ink-4);
  }
  .loop {
    margin-top: 14px;
    color: var(--ink-4);
    text-align: right;
  }
  @media (max-width: 640px) {
    .flow {
      flex-direction: column;
    }
    .arrow {
      transform: rotate(90deg);
    }
  }
</style>

---
/** A vertical timeline of releases or steps; the last (or `hero`) node is gold. */
interface Item {
  when: string;
  title: string;
  note?: string;
  hero?: boolean;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="tl">
  {
    items.map((it, i) => (
      <li class:list={{ hero: it.hero ?? i === items.length - 1 }}>
        <span class="mono when">{it.when}</span>
        <span class="node" />
        <div>
          <strong>{it.title}</strong>
          {it.note && <p>{it.note}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  li {
    display: grid;
    grid-template-columns: 96px 18px 1fr;
    gap: 12px;
    padding-bottom: 20px;
    position: relative;
  }
  li::before {
    content: "";
    position: absolute;
    left: calc(96px + 12px + 8px);
    top: 14px;
    bottom: -6px;
    width: 1px;
    background: var(--line-strong);
  }
  li:last-child::before {
    display: none;
  }
  .when {
    color: var(--ink-4);
    padding-top: 3px;
    text-align: right;
  }
  .node {
    width: 9px;
    height: 9px;
    margin: 6px 0 0 4px;
    border-radius: 50%;
    border: 1px solid var(--ink-3);
    background: var(--canvas);
    z-index: 1;
  }
  .hero .node {
    background: var(--gold);
    border-color: var(--gold);
    box-shadow: 0 0 0 4px var(--gold-wash);
  }
  strong {
    color: var(--ink);
    font-weight: 500;
  }
  p {
    margin: 4px 0 0;
    color: var(--ink-3);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>

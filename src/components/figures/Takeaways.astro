---
/** The closing checklist card. One line per item, a tick in the gold. */
interface Props {
  title?: string;
  items: string[];
}
const { title = "Keep in mind", items } = Astro.props;
---

<aside class="tk" data-reveal>
  <div class="mono hd">{title}</div>
  <ol>
    {
      items.map((it, i) => (
        <li>
          <span class="mono ix">{String(i + 1).padStart(2, "0")}</span>
          <span set:html={it} />
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .tk {
    margin: 2.6em 0;
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    border-radius: 12px;
    padding: 22px 24px 10px;
    background: var(--surface);
  }
  .hd {
    color: var(--gold);
    margin-bottom: 8px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--line-soft);
    color: var(--ink-2);
    line-height: 1.55;
  }
  li:first-child {
    border-top: 0;
  }
  .ix {
    flex: none;
    color: var(--ink-4);
    padding-top: 3px;
  }
</style>

---
/**
 * A recreated coding workspace: a grid of terminal panes, each with the CLI's
 * name, a status dot and a few lines of output. Drawn in HTML from theme
 * tokens instead of a screenshot, so it stays sharp and on-brand. Always
 * caption it "Recreated from a real session" (or "Illustration") honestly.
 */
interface Line {
  t: string;
  tone?: "dim" | "ok" | "warn" | "cmd" | "gold";
}
interface Pane {
  name: string;
  cli: string;
  status: "working" | "waiting" | "done" | "idle";
  lines: Line[];
}
interface Props {
  panes: Pane[];
  columns?: number;
  title?: string;
}
const { panes, columns = 2, title = "Workspace" } = Astro.props;
const statusText = { working: "working", waiting: "needs you", done: "done", idle: "idle" };
---

<div class="win" aria-hidden="true">
  <div class="bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="mono ttl">{title}</span>
    <span class="mono cnt">{panes.length} / 16</span>
  </div>
  <div class="grid" style={`--c:${columns}`}>
    {
      panes.map((p) => (
        <div class="pane">
          <div class="ph">
            <span class={`st st-${p.status}`} />
            <span class="nm">{p.name}</span>
            <span class="mono cli">{p.cli}</span>
            <span class="mono sx">{statusText[p.status]}</span>
          </div>
          <div class="out">
            {p.lines.map((l) => (
              <div class={`ln ${l.tone ?? ""}`}>{l.t}</div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .win {
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    background: #0a0a09;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .ttl {
    color: var(--ink-3);
  }
  .cnt {
    margin-left: auto;
    color: var(--ink-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--c), minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .pane {
    background: #0a0a09;
    min-width: 0;
  }
  .ph {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8125rem;
  }
  .nm {
    color: var(--ink);
  }
  .cli {
    color: var(--ink-4);
    font-size: 0.625rem;
  }
  .sx {
    margin-left: auto;
    color: var(--ink-4);
    font-size: 0.625rem;
  }
  .st {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
  }
  .st-working {
    background: var(--gold);
    box-shadow: 0 0 0 3px var(--gold-wash);
    animation: pulse 1.6s ease-in-out infinite;
  }
  .st-waiting {
    background: var(--chart-5);
  }
  .st-done {
    background: var(--delta-good);
  }
  .st-idle {
    background: var(--line-strong);
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .out {
    margin: 0;
    padding: 10px 12px 14px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.7;
    color: var(--ink-2);
    white-space: pre-wrap;
    overflow: hidden;
    min-height: 118px;
  }
  .dim {
    color: var(--ink-4);
  }
  .ok {
    color: var(--delta-good);
  }
  .warn {
    color: var(--chart-5);
  }
  .cmd {
    color: var(--chart-3);
  }
  .gold {
    color: var(--gold);
  }
</style>

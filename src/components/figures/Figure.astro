---
/**
 * Every visual in a post sits in one of these: a hairline frame, the visual,
 * then a caption row that opens with a "FIG A" label and states the point.
 * `source` names where the numbers came from; honesty lives in the caption.
 */
interface Props {
  fig: string;
  caption: string;
  source?: string;
  /** Screen-reader description of the whole figure (the data, in words). */
  label?: string;
  bleed?: boolean;
}
const { fig, caption, source, label, bleed = false } = Astro.props;
---

<figure class:list={["fig", { "fig-bleed": bleed }]} data-reveal role={label ? "img" : undefined} aria-label={label}>
  <div class="fig-body"><slot /></div>
  <figcaption>
    <span class="mono fig-id">Fig {fig}</span>
    <span class="fig-cap">{caption}{source && <span class="fig-src"> Source: {source}</span>}</span>
  </figcaption>
</figure>

<style>
  .fig {
    margin: 2.4em 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--canvas) 100%);
    overflow: hidden;
  }
  .fig-bleed {
    margin-right: calc(-1 * min(120px, 8vw));
  }
  @media (max-width: 960px) {
    .fig-bleed {
      margin-right: 0;
    }
  }
  .fig-body {
    padding: 28px 26px 24px;
  }
  @media (max-width: 560px) {
    .fig-body {
      padding: 20px 14px 18px;
    }
  }
  figcaption {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 12px 18px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .fig-id {
    flex: none;
    color: var(--ink);
  }
  .fig-src {
    color: var(--ink-4);
  }
</style>

---
/**
 * One horizontal bar split into parts, followed by receipt rows with dotted
 * leaders: "where does the time / money / work go". Colours follow the chart
 * palette in order unless a segment brings its own.
 */
interface Seg {
  label: string;
  value: number;
  note?: string;
  color?: string;
}
interface Props {
  segments: Seg[];
  unit?: string;
  totalLabel?: string;
  decimals?: number;
}
const { segments, unit = "", totalLabel = "Total", decimals = 0 } = Astro.props;
const total = segments.reduce((s, x) => s + x.value, 0);
const palette = [
  "var(--chart-now)",
  "var(--chart-3)",
  "var(--chart-4)",
  "var(--chart-5)",
  "var(--chart-6)",
  "var(--chart-then)",
];
const fmt = (n: number) =>
  n.toLocaleString("en-US", { maximumFractionDigits: decimals, minimumFractionDigits: decimals }) + unit;
const segs = segments.map((s, i) => ({
  ...s,
  color: s.color ?? palette[i % palette.length],
  pct: (s.value / total) * 100,
}));
---

<div class="stack" aria-hidden="true">
  {segs.map((s) => <span style={`width:${s.pct}%;background:${s.color}`} title={s.label} />)}
</div>
<div class="scale mono"><span>0</span><span>{fmt(total)}</span></div>
<ul class="receipt">
  {
    segs.map((s) => (
      <li>
        <i style={`background:${s.color}`} />
        <span class="r-label">
          {s.label}
          {s.note && <small>{s.note}</small>}
        </span>
        <span class="r-dots" />
        <span class="r-val tnum">{fmt(s.value)}</span>
        <span class="r-pct tnum">{s.pct.toFixed(0)}%</span>
      </li>
    ))
  }
  <li class="r-total">
    <i />
    <span class="r-label">{totalLabel}</span>
    <span class="r-dots" />
    <span class="r-val tnum">{fmt(total)}</span>
    <span class="r-pct tnum">100%</span>
  </li>
</ul>

<style>
  .stack {
    display: flex;
    height: 34px;
    gap: 3px;
  }
  .stack span {
    border-radius: 4px;
    min-width: 4px;
  }
  .scale {
    display: flex;
    justify-content: space-between;
    color: var(--ink-4);
    margin: 8px 0 18px;
  }
  .receipt {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }
  .receipt li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 0;
  }
  .receipt i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .r-label {
    color: var(--ink-2);
  }
  .r-label small {
    margin-left: 8px;
    color: var(--ink-4);
    font-size: 0.8125rem;
  }
  .r-dots {
    flex: 1;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-4px);
  }
  .r-val {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }
  .r-pct {
    width: 3.2em;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-4);
  }
  .r-total {
    margin-top: 6px;
    border-top: 1px solid var(--line);
  }
  .r-total .r-label {
    color: var(--ink);
  }
</style>

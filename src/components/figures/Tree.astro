---
/**
 * An ASCII-style tree for hierarchies (Project > Workspace > Session, a
 * folder layout, a config section). Lines are drawn with box characters in
 * the whisper ink; `note` sits right-aligned on the same row.
 */
interface Node {
  label: string;
  note?: string;
  hero?: boolean;
  children?: Node[];
}
interface Props {
  root: Node;
}
const { root } = Astro.props;

type Row = { prefix: string; label: string; note?: string; hero?: boolean };
const rows: Row[] = [];
const walk = (node: Node, prefix: string, isLast: boolean, depth: number) => {
  const branch = depth === 0 ? "" : isLast ? "└─ " : "├─ ";
  rows.push({ prefix: prefix + branch, label: node.label, note: node.note, hero: node.hero });
  const next = depth === 0 ? "" : prefix + (isLast ? "   " : "│  ");
  node.children?.forEach((c, i) => walk(c, next, i === node.children!.length - 1, depth + 1));
};
walk(root, "", true, 0);
---

<div class="tree">
  {
    rows.map((r) => (
      <div class="row">
        <span class="pre">{r.prefix}</span>
        <span class:list={["lab", { hero: r.hero }]}>{r.label}</span>
        {r.note && <span class="note">{r.note}</span>}
      </div>
    ))
  }
</div>

<style>
  .tree {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 2;
    overflow-x: auto;
  }
  .row {
    display: flex;
    align-items: baseline;
    white-space: pre;
  }
  .pre {
    color: var(--ink-4);
  }
  .lab {
    color: var(--ink);
  }
  .lab.hero {
    color: var(--gold);
  }
  .note {
    margin-left: auto;
    padding-left: 24px;
    color: var(--ink-4);
    font-size: 0.75rem;
    white-space: normal;
    text-align: right;
  }
</style>

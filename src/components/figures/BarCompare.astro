---
/**
 * Grouped before/after bars with direct labels and a delta line per group.
 * "then" is grey, "now" is gold, there is no y-axis because every bar carries
 * its own value. Set `lowerIsBetter` for latency/cost so the delta colours
 * the right way.
 */
interface Group {
  label: string;
  then: number;
  now: number;
}
interface Props {
  groups: Group[];
  thenLabel: string;
  nowLabel: string;
  unit?: string;
  lowerIsBetter?: boolean;
  decimals?: number;
}
const { groups, thenLabel, nowLabel, unit = "", lowerIsBetter = true, decimals = 0 } = Astro.props;
const max = Math.max(...groups.flatMap((g) => [g.then, g.now]));
const W = 640;
const H = 280;
const top = 34;
const base = 220;
const gw = W / groups.length;
const bw = Math.min(56, gw / 3.4);
const fmt = (n: number) =>
  n.toLocaleString("en-US", { maximumFractionDigits: decimals, minimumFractionDigits: decimals }) + unit;
const h = (v: number) => ((base - top) * v) / max;
const delta = (g: Group) => {
  const pct = ((g.now - g.then) / g.then) * 100;
  const good = lowerIsBetter ? pct < 0 : pct > 0;
  const x = g.then > 0 && g.now > 0 ? (lowerIsBetter ? g.then / g.now : g.now / g.then) : 0;
  const sign = pct > 0 ? "+" : "−";
  return { text: `${sign}${Math.abs(pct).toFixed(0)}%${x >= 1.95 ? ` · ${x.toFixed(1)}x` : ""}`, good };
};
const gridLines = [0.25, 0.5, 0.75, 1].map((t) => base - (base - top) * t);
---

<div class="legend mono">
  <span><i style="background:var(--chart-then)"></i>{thenLabel}</span>
  <span><i style="background:var(--chart-now)"></i>{nowLabel}</span>
</div>
<svg viewBox={`0 0 ${W} ${H}`} class="bars" aria-hidden="true">
  {gridLines.map((y) => <line x1="0" x2={W} y1={y} y2={y} stroke="var(--chart-grid)" />)}
  <line x1="0" x2={W} y1={base} y2={base} stroke="var(--line-strong)" />
  {
    groups.map((g, i) => {
      const cx = gw * i + gw / 2;
      const d = delta(g);
      return (
        <g>
          <rect x={cx - bw - 4} y={base - h(g.then)} width={bw} height={h(g.then)} rx="3" fill="var(--chart-then)" />
          <rect x={cx + 4} y={base - h(g.now)} width={bw} height={h(g.now)} rx="3" fill="var(--chart-now)" />
          <text x={cx - bw / 2 - 4} y={base - h(g.then) - 8} class="val" fill="var(--ink-3)">
            {fmt(g.then)}
          </text>
          <text x={cx + bw / 2 + 4} y={base - h(g.now) - 8} class="val" fill="var(--ink)">
            {fmt(g.now)}
          </text>
          <text x={cx} y={base + 24} class="lab" fill="var(--ink-2)">
            {g.label}
          </text>
          <text x={cx} y={base + 46} class="delta" fill={d.good ? "var(--delta-good)" : "var(--delta-bad)"}>
            {d.text}
          </text>
        </g>
      );
    })
  }
</svg>

<style>
  .legend {
    display: flex;
    gap: 18px;
    color: var(--ink-3);
    margin-bottom: 10px;
  }
  .legend i {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 7px;
    vertical-align: -1px;
  }
  .bars {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .val,
  .lab,
  .delta {
    text-anchor: middle;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .val {
    font-size: 13px;
  }
  .lab {
    font-size: 13px;
    font-family: var(--font-sans);
  }
  .delta {
    font-size: 12px;
  }
</style>

---
/**
 * The month's value at API prices as one bar, split into the part that ran on
 * flat monthly subscriptions (no extra charge) and the part billed to API keys.
 * Read from src/data/costs-september.json (`totals`).
 */
import data from "@/data/costs-september.json";

const t = data.totals;
const W = 640;
const H = 196;
const barY = 58;
const barH = 46;
const subW = (t.subscription / t.value) * W;
const keyW = W - subW;
const money = (v: number) => `$${v.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const pct = (v: number) => `${((v / t.value) * 100).toFixed(1)}%`;
const subTip = `<b>Flat subscriptions</b><br>${money(t.subscription)} of work, ${pct(t.subscription)}<br>No extra charge per token`;
const keyTip = `<b>Billed to API keys</b><br>${money(t.billed)}, ${pct(t.billed)}<br>Money that left a key`;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`One bar for the ${money(t.value)} the month's work was worth at API prices: ${money(t.subscription)} (${pct(t.subscription)}) ran on flat monthly subscriptions at no extra charge, ${money(t.billed)} (${pct(t.billed)}) was billed to API keys.`}>
  <path d={`M0,${barY - 14} V${barY - 24} H${W} V${barY - 14}`} fill="none" stroke="var(--ink-3)" />
  <text class="t-strong" x={0} y={barY - 32}>{money(t.value)}: what the work would have cost on pay-per-token APIs</text>

  <rect x={0} y={barY} width={subW - 2} height={barH} fill="var(--mark-muted)" data-tip={subTip} />
  <text class="t-strong" x={14} y={barY + 29} pointer-events="none">{pct(t.subscription)} ran on flat subscriptions: {money(t.subscription)}, no extra charge</text>
  <rect x={subW} y={barY} width={Math.max(keyW, 4)} height={barH} fill="var(--accent)" data-tip={keyTip} />

  <path d={`M${W - 2},${barY + barH + 4} V${barY + barH + 34} H${W - 40}`} fill="none" stroke="var(--ink-3)" />
  <text class="t-strong" x={W - 48} y={barY + barH + 39} text-anchor="end" style="fill: var(--accent)">{money(t.billed)} billed to API keys</text>
  <text class="t-label" x={W - 48} y={barY + barH + 58} text-anchor="end">{pct(t.billed)} of the work, the only part with a per-token bill</text>
</svg>

---
/**
 * The wait between letting go of the dictation key and having the finished
 * transcript, by length of the dictation: in August (before the final windows
 * were read while you speak) and on October 1-2 (with that change and the
 * on-device final pass). Read from src/data/jarvis-voice.json (`wait`).
 */
import data from "@/data/jarvis-voice.json";
import { barUp, esc } from "./util";

const W = 640;
const H = 250;
const top = 26;
const base = H - 44;
const left = 40;
const max = 5000;
const groups = data.wait.before.map((b, i) => ({ bucket: b.bucket, before: b.medianMs, after: data.wait.after[i] }));
const slot = (W - left) / groups.length;
const bw = slot * 0.26;
const y = (v: number) => base - ((base - top) * v) / max;
const sec = (ms: number) => `${(ms / 1000).toFixed(ms < 1000 ? 2 : 1)} s`;
const LABEL: Record<string, string> = {
  Short: "Short dictations",
  "25 to 50 s": "25 to 50 seconds",
  "Over 50 s": "Over 50 seconds",
};
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={"Median wait after releasing the key. " + groups.map((g) => `${LABEL[g.bucket]}: ${sec(g.before)} in August, ${sec(g.after.medianMs)} in October`).join("; ")}>
  {
    [0, 1000, 2000, 3000, 4000, 5000].map((v) => (
      <g>
        <line x1={left} x2={W} y1={y(v)} y2={y(v)} stroke={v === 0 ? "var(--axis)" : "var(--grid)"} />
        <text class="t-axis" x={0} y={y(v) + 4}>{v / 1000} s</text>
      </g>
    ))
  }
  {
    groups.map((g, i) => {
      const cx = left + i * slot + slot / 2;
      const xb = cx - bw - 3;
      const xa = cx + 3;
      const tip = `<b>${esc(LABEL[g.bucket])}</b><br>August: ${sec(g.before)}<br>October: ${sec(g.after.medianMs)} (${g.after.n} dictations)`;
      return (
        <g>
          <rect class="hit" x={left + i * slot} y={top - 20} width={slot} height={H - top + 20} data-tip={tip} />
          <rect class="hl" x={left + i * slot + 2} y={top - 20} width={slot - 4} height={H - top + 16} rx="5" fill="var(--ink)" fill-opacity="0.05" pointer-events="none" />
          <path d={barUp(xb, y(g.before), bw, base)} fill="var(--mark-muted)" pointer-events="none" />
          <path d={barUp(xa, y(g.after.medianMs), bw, base)} fill="var(--accent)" pointer-events="none" />
          <text class="t-label" x={xb + bw / 2} y={y(g.before) - 7} text-anchor="middle" pointer-events="none">{sec(g.before)}</text>
          <text class="t-strong" x={xa + bw / 2} y={y(g.after.medianMs) - 7} text-anchor="middle" pointer-events="none">{sec(g.after.medianMs)}</text>
          <text class="t-label" x={cx} y={base + 18} text-anchor="middle" pointer-events="none">{LABEL[g.bucket]}</text>
          <text class="t-axis" x={cx} y={base + 34} text-anchor="middle" pointer-events="none">October: {g.after.n} dictations</text>
        </g>
      );
    })
  }
</svg>

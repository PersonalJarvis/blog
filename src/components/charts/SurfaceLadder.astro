---
/**
 * Where in the app September's value came from, on a log scale because the
 * parts differ by six orders of magnitude: a ring for what the work was worth
 * at API prices, a dot for what was billed to an API key.
 * Read from src/data/costs-september.json (`surfaces`, `totals.freeTokens`).
 */
import data from "@/data/costs-september.json";

const NAMES: Record<string, string> = {
  "agentic-ide": "Coding agents in the Agentic IDE",
  "agent-chat": "Chats with agents",
  voice: "Voice conversations",
  background: "Background jobs",
  "jarvis-voice": "Speech to text, text to speech",
};
const W = 640;
const L = 214;
const R = 70;
const T = 40;
const rowH = 44;
const rows = data.surfaces.map((s) => ({ ...s, name: NAMES[s.key] ?? s.key }));
const H = T + (rows.length + 1) * rowH + 30;
const lo = -2;
const hi = 5;
const x = (v: number) => L + ((W - L - R) * (Math.log10(Math.max(v, 10 ** lo)) - lo)) / (hi - lo);
const ticks = [0.01, 1, 100, 10000];
const tickLabel = (v: number) => (v < 1 ? "1¢" : `$${v.toLocaleString("en-US")}`);
const money = (v: number) => (v >= 100 ? `$${Math.round(v).toLocaleString("en-US")}` : `$${v.toFixed(2)}`);
const axisY = T + (rows.length + 1) * rowH - 8;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={"Dot chart on a logarithmic scale of where September's value came from. " + rows.map((r) => `${r.name}: worth ${money(r.value)}, billed ${money(r.billed)}`).join("; ") + `; local models: ${(data.totals.freeTokens / 1e6).toFixed(0)} million tokens at no cost.`}>
  {
    ticks.map((v) => (
      <g>
        <line x1={x(v)} x2={x(v)} y1={T - 14} y2={axisY} stroke="var(--grid)" />
        <text class="t-axis" x={x(v)} y={axisY + 18} text-anchor="middle">
          {tickLabel(v)}
        </text>
      </g>
    ))
  }
  <text class="t-axis" x={W - R} y={axisY + 18} text-anchor="end" dx="62">log scale</text>
  {
    rows.map((r, i) => {
      const cy = T + i * rowH;
      const tip = `<b>${r.name}</b><br>Worth at API prices: ${money(r.value)}<br>Billed to API keys: ${money(r.billed)}<br>${(r.tokens / 1e6).toLocaleString("en-US", { maximumFractionDigits: 1 })} million tokens`;
      return (
        <g>
          <rect class="hit" x={0} y={cy - rowH / 2} width={W} height={rowH} data-tip={tip} />
          <rect class="hl" x={0} y={cy - rowH / 2 + 3} width={W} height={rowH - 6} rx="5" fill="var(--ink)" fill-opacity="0.05" pointer-events="none" />
          <text class="t-label" x={0} y={cy + 4} pointer-events="none">
            {r.name}
          </text>
          {r.billed > 0 && r.billed < r.value && (
            <line x1={x(r.billed)} x2={x(r.value)} y1={cy} y2={cy} stroke="var(--ink-4)" stroke-dasharray="2 3" pointer-events="none" />
          )}
          <circle cx={x(r.value)} cy={cy} r="8" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" pointer-events="none" />
          {r.billed > 0 && <circle cx={x(r.billed)} cy={cy} r="5" fill="var(--accent)" pointer-events="none" />}
          <text class="t-strong" x={x(r.value) + 14} y={cy + 4} pointer-events="none">
            {money(r.value)}
          </text>
        </g>
      );
    })
  }
  <text class="t-label" x={0} y={T + rows.length * rowH + 4}>Local and free models</text>
  <text class="t-note" x={L} y={T + rows.length * rowH + 4}>{(data.totals.freeTokens / 1e6).toFixed(0)} million tokens, $0</text>
</svg>

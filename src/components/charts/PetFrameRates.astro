---
/**
 * How many new frames a second the pet window draws in each state: the fps of
 * that state's sprite row (identical across the built-in pets), plus "hidden",
 * where the frame timer stops. Read from src/data/pets.json.
 */
import data from "@/data/pets.json";
import { barUp, esc } from "./util";

const LABEL: Record<string, string> = {
  hidden: "Hidden",
  sleeping: "Sleeping",
  idle: "Idle",
  listening: "Listening",
  thinking: "Thinking",
  working: "Working",
  searching: "Searching",
  error: "Error",
  talking: "Talking",
  success: "Success",
  held: "Being carried",
};
const NOTE: Record<string, string> = {
  hidden: "The frame timer stops; nothing is drawn",
  sleeping: "After five minutes without a Jarvis event",
  idle: "Plus an idle act now and then, at 6 to 10 fps",
  talking: "While a voice level arrives, the mouth frame follows it",
  success: "One-shot, 1.5 s",
  error: "One-shot, 2 s",
};

const anims = data.pets[0].animations as Record<string, { fps: number }>;
const rows = [{ key: "hidden", fps: 0 }, ...Object.entries(anims).map(([key, a]) => ({ key, fps: a.fps }))].sort(
  (a, b) => a.fps - b.fps || Object.keys(LABEL).indexOf(a.key) - Object.keys(LABEL).indexOf(b.key),
);
const W = 640;
const H = 250;
const top = 26;
const base = H - 44;
const left = 28;
const max = 12;
const slot = (W - left) / rows.length;
const bw = slot * 0.56;
const y = (v: number) => base - ((base - top) * v) / max;
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={"Frames per second the pet draws, by state: " + rows.map((r) => `${LABEL[r.key]} ${r.fps}`).join("; ")}>
  {
    [0, 3, 6, 9, 12].map((v) => (
      <g>
        <line x1={left} x2={W} y1={y(v)} y2={y(v)} stroke={v === 0 ? "var(--axis)" : "var(--grid)"} />
        <text class="t-axis" x={0} y={y(v) + 4}>{v}</text>
      </g>
    ))
  }
  {
    rows.map((r, i) => {
      const x = left + i * slot + (slot - bw) / 2;
      const tip = `<b>${esc(LABEL[r.key])}: ${r.fps} fps</b>` + (NOTE[r.key] ? `<br>${esc(NOTE[r.key])}` : "");
      const fill = r.key === "idle" || r.key === "sleeping" || r.key === "hidden" ? "var(--accent)" : "var(--mark-muted)";
      return (
        <g>
          <rect class="hit" x={left + i * slot} y={top - 20} width={slot} height={H - top + 20} data-tip={tip} />
          <rect class="hl" x={left + i * slot + 2} y={top - 20} width={slot - 4} height={H - top + 16} rx="5" fill="var(--ink)" fill-opacity="0.05" pointer-events="none" />
          <path d={barUp(x, y(r.fps), bw, base)} fill={fill} pointer-events="none" />
          <text class="t-strong" x={x + bw / 2} y={y(r.fps) - 7} text-anchor="middle" pointer-events="none">{r.fps}</text>
          <text class="t-label" x={x + bw / 2} y={base + 18} text-anchor="middle" pointer-events="none">
            {LABEL[r.key].split(" ")[0]}
          </text>
          {LABEL[r.key].includes(" ") && (
            <text class="t-label" x={x + bw / 2} y={base + 33} text-anchor="middle" pointer-events="none">
              {LABEL[r.key].split(" ").slice(1).join(" ")}
            </text>
          )}
        </g>
      );
    })
  }
</svg>

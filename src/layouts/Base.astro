---
import "@/styles/global.css";
import { OG_VERSION, SITE, href } from "@/lib";
// Both faces set text above the fold. Preloaded, they start with the HTML
// instead of after the stylesheet, which halved the first paint on a phone
// (Lighthouse A/B: ~1.5 s -> ~0.7 s). These are the same files global.css
// loads through @fontsource; Vite emits one hashed asset for both, so the
// preload and the @font-face share a URL and a single download.
import serifFont from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  /** Site-internal path of the social card, e.g. href("og/slug.png"). */
  image?: string;
  article?: { published: Date; modified?: Date; section: string };
  jsonLd?: Record<string, unknown>;
}

const { title, description, image = href("og/default.png"), article, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
ogImage.searchParams.set("v", String(OG_VERSION));
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131311" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href("gigi.svg")} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={href("rss.xml")} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@PersonalJarvis" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={href()}>
          <img src={href("gigi.svg")} alt="" width="26" height="28" />
          Personal Jarvis <span>Blog</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          <a class="wide-only" href={SITE.main}>Product</a>
          <a href={href("rss.xml")}>RSS</a>
          <a class="gh" href={SITE.github} aria-label="Personal Jarvis on GitHub" title="Personal Jarvis on GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-foot small">
      <div class="wrap">
        <span>Personal Jarvis — an open-source AI assistant for your desktop.</span>
        <a href={SITE.main}>personaljarvis.ai</a>
        <a href={SITE.github}>GitHub</a>
        <a href={`${SITE.main}/imprint/`}>Imprint</a>
        <a class="end" href={href("rss.xml")}>Subscribe via RSS</a>
      </div>
    </footer>

    <script>
      // One tooltip per chart. Marks carry their tooltip as data-tip (markup
      // written at build time from our own data, never from user input).
      document.querySelectorAll<HTMLElement>(".figure-plot").forEach((plot) => {
        const tip = document.createElement("div");
        tip.className = "tip";
        tip.setAttribute("role", "status");
        plot.appendChild(tip);
        let lit: Element | null = null;
        const hide = () => {
          tip.classList.remove("on");
          lit?.classList.remove("on");
          lit = null;
        };
        plot.addEventListener("pointermove", (e) => {
          const target = (e.target as Element).closest("[data-tip]");
          if (!target) return hide();
          tip.innerHTML = target.getAttribute("data-tip") ?? "";
          // Keep the whole tooltip inside the part of the chart that is on
          // screen: .figure-scroll clips everything outside it, and on a phone
          // the plot is wider than that window. Measure the tooltip itself,
          // never assume a width, and flip it below the pointer near the top.
          const box = plot.getBoundingClientRect();
          const view = (plot.closest(".figure-scroll") ?? plot).getBoundingClientRect();
          const left = Math.max(box.left, view.left) - box.left;
          const right = Math.min(box.right, view.right) - box.left;
          const top = Math.max(box.top, view.top) - box.top;
          const pad = 4;
          const half = tip.offsetWidth / 2;
          const x =
            right - left < tip.offsetWidth + 2 * pad
              ? (left + right) / 2
              : Math.min(Math.max(e.clientX - box.left, left + half + pad), right - half - pad);
          const y = e.clientY - box.top;
          tip.classList.toggle("below", y - tip.offsetHeight - 10 < top + pad);
          tip.style.left = `${x}px`;
          tip.style.top = `${y}px`;
          tip.classList.add("on");
          const hl = target.nextElementSibling;
          if (lit !== hl) {
            lit?.classList.remove("on");
            lit = hl && hl.classList.contains("hl") ? hl : null;
            lit?.classList.add("on");
          }
        });
        plot.addEventListener("pointerleave", hide);
      });
    </script>
  </body>
</html>
